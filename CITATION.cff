    orcid: "https://orcid.org/0000-0003-4482-3490"
license: GPL-3.0-only
repository-code: "https://github.com/akif-k/ipa4turkish"
version: "1.0.1"
date-released: "2026-08-24"
keywords:
  - phonetics
  - IPA
  - forced alignment
  - speech processing
  - wav2vec2
  - syllabification
  - Turkish
